<Project Sdk="Microsoft.NET.Sdk">
  <!-- GK2 HUD+: os módulos dos mods de jogador num plugin só. Cada pasta de mod entra inteira, menos o Plugin.cs dela
       (o ponto de entrada do mod avulso); o ponto de entrada daqui é o Plugin.cs desta pasta. -->
  <PropertyGroup>
    <AssemblyName>GK2HudPlus</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/ModGuard.cs" Link="Shared/ModGuard.cs" />
    <Compile Include="../Shared/ModHost.cs" Link="Shared/ModHost.cs" />
    <Compile Include="../Shared/HudPlusId.cs" Link="Shared/HudPlusId.cs" />
    <Compile Include="../GK2Hud/**/*.cs" Exclude="../GK2Hud/Plugin.cs;../GK2Hud/bin/**;../GK2Hud/obj/**" Link="GK2Hud/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../GK2Map/**/*.cs" Exclude="../GK2Map/Plugin.cs;../GK2Map/bin/**;../GK2Map/obj/**" Link="GK2Map/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../GK2Saves/**/*.cs" Exclude="../GK2Saves/Plugin.cs;../GK2Saves/bin/**;../GK2Saves/obj/**" Link="GK2Saves/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../GK2ZombieRefund/**/*.cs" Exclude="../GK2ZombieRefund/Plugin.cs;../GK2ZombieRefund/bin/**;../GK2ZombieRefund/obj/**" Link="GK2ZombieRefund/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- BurstableBounds (limites dos ladrilhos de terreno, GK2Map) usa float3. -->
    <Reference Include="$(Refs)/Managed/Unity.Mathematics.dll" Private="false" />
  </ItemGroup>
</Project>
