<Project Sdk="Microsoft.NET.Sdk">
  <!-- Host de cenários do `gk2 run`: compila work/Snippet.cs contra o jogo. -->
  <PropertyGroup>
    <AssemblyName>Snippet</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Só os cenários: Addressables e FlowCanvas (grafos de diálogo/script do jogo, usados pelo índice de gatilhos). -->
    <Reference Include="$(Refs)/Managed/Unity.Addressables.dll" Private="false" />
    <Reference Include="$(Refs)/Managed/Unity.ResourceManager.dll" Private="false" />
    <Reference Include="$(Refs)/Managed/FlowCanvas.dll" Private="false" />
    <Reference Include="$(Refs)/Managed/NodeCanvas.dll" Private="false" />
    <Reference Include="$(Refs)/Managed/ParadoxNotion.dll" Private="false" />
    <Reference Include="$(Refs)/Managed/PackageTools.dll" Private="false" />
    <Reference Include="$(Refs)/Managed/Drawing.dll" Private="false" />
    <Reference Include="$(Refs)/Managed/Unity.Mathematics.dll" Private="false" />
  </ItemGroup>
</Project>
