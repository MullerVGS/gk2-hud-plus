#!/usr/bin/env bash
# CLI único para desenvolver mods do Graveyard Keeper 2 na instância green. Rode `gk2 help`.
set -euo pipefail
trap 'echo "gk2: falhou na linha $LINENO: $BASH_COMMAND" >&2' ERR

HERE=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
BLUE=${GK2_BLUE_DIR:-/mnt/d/SteamLibrary/steamapps/common/Graveyard Keeper 2}
GREEN=${GK2_GREEN_DIR:-/mnt/d/GK2-green}
GREEN_WIN='D:\GK2-green'
SNAPSHOTS=/mnt/d/GK2-green-saves
WINHOME=${GK2_WINHOME:-$(wslpath "$(cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r')")}
[ -d "$WINHOME/AppData" ] || { echo "gk2: pasta do usuário do Windows não encontrada (cmd.exe falhou?); nada feito" >&2; exit 1; }
BLUE_DATA="$WINHOME/AppData/LocalLow/Lazy Bear Games/Graveyard Keeper 2"
GREEN_DATA="$WINHOME/AppData/LocalLow/Lazy Bear Games/GK2 Green Instance"
# Porta da DevBridge: a do .cfg do green (fonte única). Fora da faixa efêmera do Linux: no WSL mirrored ela fica
# reservada no Windows e a ponte não consegue abrir a porta (ip_local_port_range muda a cada boot do WSL).
PORT=${GK2_BRIDGE_PORT:-$(sed -n 's/^Port *= *\([0-9]*\).*/\1/p' "$GREEN/BepInEx/config/arthur.gk2.devbridge.cfg" 2>/dev/null | head -1 || true)}
PORT=${PORT:-27777}  # padrão do Bridge.cs; o cfg só existe depois da primeira carga da DevBridge
URL="http://127.0.0.1:$PORT"
SHOTS="$HERE/.shots"
BUILDER=gk2-builder
SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:8.0.425

die() { echo "gk2: $*" >&2; exit 1; }
ps1() { local f=$1; shift; powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(wslpath -w "$HERE/tools/$f")" "$@" | tr -d '\r'; }
winpath() { wslpath -w "$1"; }

refs() {
  mkdir -p "$HERE/refs/Managed" "$HERE/refs/core"
  # Só recopia quando o jogo mudou (Assembly-CSharp diferente).
  if ! cmp -s "$BLUE/GraveyardKeeper2_Data/Managed/Assembly-CSharp.dll" "$HERE/refs/Managed/Assembly-CSharp.dll"; then
    cp -L "$BLUE"/GraveyardKeeper2_Data/Managed/*.dll "$HERE/refs/Managed/"
    cp -L "$BLUE"/BepInEx/core/*.dll "$HERE/refs/core/"
    echo "refs atualizadas a partir do jogo"
  fi
}

builder() {
  if [ "$(docker inspect -f '{{.State.Running}}' "$BUILDER" 2>/dev/null)" != "true" ]; then
    docker rm -f "$BUILDER" >/dev/null 2>&1 || true
    docker run -d --name "$BUILDER" -v "$HERE":/src -w /src "$SDK_IMAGE" sleep infinity >/dev/null
  fi
}

# build <Projeto> [msbuild args...] → imprime o caminho da DLL
build() {
  local proj=$1; shift
  [ -f "$HERE/$proj/$proj.csproj" ] || die "projeto $proj não existe (esperado $proj/$proj.csproj)"
  refs >&2
  builder
  docker exec -w "/src/$proj" "$BUILDER" dotnet build -c Release -nologo -v q -clp:NoSummary "$@" >&2 || die "build de $proj falhou"
  echo "$HERE/$proj/bin/Release/$proj.dll"
}

api() { curl -sS --max-time "${GK2_TIMEOUT:-90}" "$URL$1"; }

bridge_up() { curl -sS --max-time 2 "$URL/ping" >/dev/null 2>&1; }

wait_bridge() {
  local limit=${1:-120}
  for _ in $(seq 1 "$limit"); do bridge_up && return 0; sleep 1; done
  local lo hi
  read -r lo hi < /proc/sys/net/ipv4/ip_local_port_range
  if [ "$PORT" -ge "$lo" ] && [ "$PORT" -le "$hi" ]; then
    die "ponte não respondeu: a porta $PORT está na faixa efêmera do WSL ($lo-$hi), reservada no Windows; troque Port no arthur.gk2.devbridge.cfg do green"
  fi
  die "ponte não respondeu em ${limit}s (green rodando? DevBridge instalada?)"
}

stage() { # copia uma DLL para a pasta dev do green e imprime o caminho Windows
  local dll=$1 name=$2
  mkdir -p "$GREEN/BepInEx/dev"
  find "$GREEN/BepInEx/dev" -name '*.dll' -mmin +60 -delete 2>/dev/null || true
  local dst="$GREEN/BepInEx/dev/$name-$(date +%s%N).dll"
  cp "$dll" "$dst"
  winpath "$dst"
}

install_green() { # copia para BepInEx/plugins do green; se a DLL estiver travada pelo jogo, deixa .next para o próximo start
  local dll=$1 proj=$2 dst="$GREEN/BepInEx/plugins/$2/$2.dll"
  mkdir -p "$(dirname "$dst")"
  if cp "$dll" "$dst" 2>/dev/null; then rm -f "$dst.next"; else cp "$dll" "$dst.next"; echo "(DLL em uso pelo green: ficou $proj.dll.next, aplicado no próximo start)"; fi
}

apply_pending() {
  find "$GREEN/BepInEx/plugins" -name '*.dll.next' 2>/dev/null | while read -r f; do mv -f "$f" "${f%.next}"; echo "aplicado ${f##*/}"; done
}

urlenc() { python3 -c 'import urllib.parse,sys;print(urllib.parse.quote(sys.argv[1]))' "$1"; }

pretty() { python3 -c 'import json,sys; d=json.load(sys.stdin); print(json.dumps(d,indent=2,ensure_ascii=False))'; }

print_logs() { python3 "$HERE/tools/fmtlog.py"; }

cmd=${1:-help}; shift || true
case "$cmd" in
  green)
    sub=${1:-status}
    case "$sub" in
      start) apply_pending; ps1 green.ps1 start ;;
      stop) bridge_up && api /quit >/dev/null 2>&1 && sleep 3; ps1 green.ps1 stop ;;
      restart) "$0" green stop; apply_pending; ps1 green.ps1 start ;;
      status|show|hide|sync-settings) ps1 green.ps1 "$sub" ;;
      *) die "green start|stop|restart|status|show|hide|sync-settings" ;;
    esac
    ;;
  green-sync)
    # Re-sincroniza a cópia green com o jogo (após atualização do Steam). Copia só o que é do jogo: tudo fora de
    # BepInEx (espelhado), os arquivos da raiz (sem apagar nada) e BepInEx/core e patchers. O resto do BepInEx do green
    # (plugins, config, hot, dev, estado do WorkshopSync) é do ambiente de desenvolvimento e nunca é tocado. Em 13/11 o
    # espelho com exclusões levou plugins, config e o estado do WorkshopSync do blue para o green.
    ps1 green.ps1 status | grep -q parado || die "pare o green antes (gk2 green stop)"
    src=$(winpath "$BLUE"); opts="/NFL /NDL /NJH /NJS /NP /R:1 /W:1"; ps=""
    rc() { ps+="robocopy $1 $opts; if (\$LASTEXITCODE -ge 8) { \$falhas += '$2' }; "; }
    for d in "$BLUE"/*/; do n=$(basename "$d"); [ "$n" = BepInEx ] && continue; rc "'$src\\$n' '$GREEN_WIN\\$n' /MIR" "$n"; done
    rc "'$src' '$GREEN_WIN' /XF steam_appid.txt" "raiz"
    for d in core patchers; do rc "'$src\\BepInEx\\$d' '$GREEN_WIN\\BepInEx\\$d' /MIR" "BepInEx/$d"; done
    out=$(powershell.exe -NoProfile -Command "\$falhas = @(); $ps if (\$falhas.Count) { 'FALHOU: ' + (\$falhas -join ', ') } else { 'COPIA_OK' }" | tr -d '\r' | grep -E 'COPIA_OK|FALHOU' || true)
    [ "$out" = COPIA_OK ] || die "green-sync incompleto: ${out:-sem resposta do robocopy}"; echo "cópia ok"
    for d in "$GREEN"/*/; do n=$(basename "$d"); [ -e "$BLUE/$n" ] || echo "aviso: $n só existe no green (o jogo removeu? apague à mão se for o caso)"; done
    python3 - "$GREEN/GraveyardKeeper2_Data" <<'EOF'
import sys, os
old, new = b'Graveyard Keeper 2', b'GK2 Green Instance'
for f in ('globalgamemanagers', 'app.info'):
    p = os.path.join(sys.argv[1], f); b = open(p, 'rb').read()
    if b.count(new) == 1: print(f, 'já corrigido'); continue
    assert b.count(old) == 1, (f, b.count(old)); open(p, 'wb').write(b.replace(old, new)); print(f, 'corrigido')
EOF
    printf '480' > "$GREEN/steam_appid.txt"  # Spacewar: o Steam não vê o green como GK2 e o blue continua abrindo
    ;;
  save)
    sub=${1:-}
    case "$sub" in
      snapshot) mkdir -p "$SNAPSHOTS/snapshot"; cp "$BLUE_DATA"/Steam_1.dat "$BLUE_DATA"/Steam_1.info "$SNAPSHOTS/snapshot/"; ls -la "$SNAPSHOTS/snapshot" ;;
      reset) [ -f "$SNAPSHOTS/snapshot/Steam_1.dat" ] || die "sem snapshot"; mkdir -p "$GREEN_DATA"
        rm -f "$GREEN_DATA"/Steam_1_*.dat "$GREEN_DATA"/Steam_1_*.info "$GREEN_DATA"/Steam_1*.new
        rm -rf "$GREEN/BepInEx/config/arthur.gk2.saves/history"
        cp "$SNAPSHOTS"/snapshot/Steam_1.* "$GREEN_DATA/"; echo "save do green = snapshot, sem backups nem histórico do GK2Saves (recarregue o save no jogo)"
        if [ -f "$SNAPSHOTS/inicio/Steam_2.dat" ]; then   # jogo novo de gravação (clipes sem spoiler)
          rm -f "$GREEN_DATA"/Steam_2_*.dat "$GREEN_DATA"/Steam_2_*.info "$GREEN_DATA"/Steam_2*.new
          cp "$SNAPSHOTS"/inicio/Steam_2.* "$GREEN_DATA/"
          # O diário do GK2 HUD+ vive fora do save: volta junto, senão o mod trata as anotações como "antes do diário".
          [ -f "$SNAPSHOTS/inicio/journal-Steam_2.json" ] && cp "$SNAPSHOTS/inicio/journal-Steam_2.json" "$GREEN/BepInEx/config/arthur.gk2.hud/"
          echo "Steam_2 = jogo novo de gravação (snapshot inicio, com o diário)"
        fi ;;
      inicio) # guarda o Steam_2 do green (jogo novo de gravação, feito com jogo-novo.cs + intro-conduzir.cs + jogo-novo-quests.cs)
        [ -f "$GREEN_DATA/Steam_2.dat" ] || die "o green não tem Steam_2"
        mkdir -p "$SNAPSHOTS/inicio"; cp "$GREEN_DATA"/Steam_2.dat "$GREEN_DATA"/Steam_2.info "$SNAPSHOTS/inicio/"
        j="$GREEN/BepInEx/config/arthur.gk2.hud/journal-Steam_2.json"; [ -f "$j" ] && cp "$j" "$SNAPSHOTS/inicio/"
        ls -la "$SNAPSHOTS/inicio" ;;
      *) die "save snapshot|reset|inicio" ;;
    esac
    ;;
  build) build "${1:?projeto}" ;;
  bridge)
    # Instala a DevBridge no green. Ela não se recarrega a quente: reinicia o green se estiver rodando.
    dll=$(build GK2DevBridge)
    if ps1 green.ps1 status | grep -q rodando; then "$0" green stop; restart=1; fi
    install_green "$dll" GK2DevBridge; apply_pending
    echo "DevBridge instalada no green"
    if [ "${restart:-0}" = 1 ]; then ps1 green.ps1 start; wait_bridge; api /ping | pretty; fi
    ;;
  deploy)
    # build + instala no green (persistente) + hot-reload se a ponte estiver no ar
    proj=${1:?projeto}
    case "$proj" in
      GK2Hud|GK2Map|GK2Saves|GK2ZombieRefund)
        [ -d "$GREEN/BepInEx/plugins/GK2HudPlus" ] && die "o GK2 HUD+ está no green e já traz $proj; para testar o avulso, tire BepInEx/plugins/GK2HudPlus do green" ;;
    esac
    dll=$(build "$proj")
    if [ "$proj" = GK2HudPlus ]; then
      # O pacote substitui os avulsos: descarrega os que estiverem rodando e tira as pastas deles do green.
      for m in GK2Hud:arthur.gk2.hud GK2Map:arthur.gk2.map GK2Saves:arthur.gk2.saves GK2ZombieRefund:arthur.gk2.zombierefund; do
        dir="$GREEN/BepInEx/plugins/${m%%:*}"; [ -d "$dir" ] || continue
        bridge_up && api "/unload?guid=${m#*:}" >/dev/null
        rm -rf "$dir" 2>/dev/null || { mv "$dir" "$GREEN/BepInEx/plugins/~${m%%:*}.removido" 2>/dev/null; }
        echo "avulso ${m%%:*} retirado do green (vem no GK2 HUD+)"
      done
    fi
    install_green "$dll" "$proj"
    if [ -d "$HERE/$proj/previews" ]; then   # clipes do menu (gk2 rec), lidos de BepInEx/plugins/<proj>/previews
      mkdir -p "$GREEN/BepInEx/plugins/$proj/previews"; cp -u "$HERE/$proj/previews/"*.webm "$GREEN/BepInEx/plugins/$proj/previews/" 2>/dev/null || true
    fi
    if bridge_up; then
      path=$(stage "$dll" "$proj")
      api "/reload?path=$(python3 -c 'import urllib.parse,sys;print(urllib.parse.quote(sys.argv[1]))' "$path")" | print_logs
    else
      echo "ponte fora do ar: instalado em plugins, vale no próximo start do green"
    fi
    ;;
  unload) api "/unload?guid=${1:?guid}" | pretty ;;
  rec)
    # gk2 rec status [--estrito] | todos | desatualizados | <Id>...   (receitas em tools/rec/clips.txt; ver tools/rec/rec.py)
    python3 "$HERE/tools/rec/rec.py" "$0" "$HERE" "$@" ;;
  showcase)
    # gk2 showcase [webp|trailer|tudo]: mídias de divulgação a partir de docs/media/*.mp4 (ver tools/rec/showcase.py)
    if [ "${1:-}" = capa ]; then python3 "$HERE/tools/rec/cover.py" "$HERE"; exit; fi   # prints capa-* em .shots/ (ver cover.py)
    python3 "$HERE/tools/rec/showcase.py" "$HERE" "${1:-tudo}" "${@:2}" ;;
  package)
    # gk2 package <Proj>: zip no layout do contrato de mods do jogo (descompactar em <dados do jogo>/Mods/Code/)
    proj=${1:?projeto}; dll=$(build "$proj")
    ver=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["version"])' "$HERE/$proj/modinfo.json")
    tmp=$(mktemp -d); item="$tmp/$proj"; mkdir -p "$item/BepInEx/plugins/$proj" "$HERE/dist"
    cp "$HERE/$proj/modinfo.json" "$item/"; cp "$dll" "$item/BepInEx/plugins/$proj/"
    if [ -d "$HERE/$proj/previews" ]; then mkdir "$item/BepInEx/plugins/$proj/previews"; cp "$HERE/$proj/previews/"*.webm "$item/BepInEx/plugins/$proj/previews/"; fi
    out="$HERE/dist/$proj-$ver.zip"; rm -f "$out"
    python3 -c 'import shutil,sys;shutil.make_archive(sys.argv[1][:-4],"zip",sys.argv[2])' "$out" "$tmp"; rm -rf "$tmp"
    echo "pacote: $out"; sha256sum "$out" ;;
  rec-clip)
    # gk2 rec-clip <cenario.cs> <x,y,w,h> <nome> [--fps n] [--antes s] [--depois s] [--escala n] [--tomada] [K=V ...]
    # --tomada: gravação de divulgação (docs/media/tomadas/<nome>.mp4, nada em previews/); --escala 2 guarda 1 pixel de
    # arte por pixel (um quarto da memória), o que deixa gravar a tela inteira a 60 qps.
    # Grava um clipe da região (px de tela, alinhada em pares) enquanto o cenário roda. Saídas: GK2HudPlus/previews/<nome>.webm
    # (preview do menu, VP8) e docs/media/<nome>.gif e .mp4 (páginas). K=V troca constantes do cenário, como no smoke.
    src=${1:?cenário}; reg=${2:?x,y,w,h}; nome=${3:?nome}; shift 3
    fps=20; antes=0.4; depois=0.6; subs=(); escala=1; tomada=0
    while [ $# -gt 0 ]; do case "$1" in
      --fps) fps=$2; shift ;; --escala) escala=$2; shift ;; --tomada) tomada=1 ;; --antes) antes=$2; shift ;; --depois) depois=$2; shift ;; *=*) subs+=("$1") ;; *) die "opção desconhecida: $1" ;;
    esac; shift; done
    IFS=, read -r rx ry rw rh <<<"$reg"; rx=$((rx/2*2)); ry=$((ry/2*2)); rw=$((rw/2*2)); rh=$((rh/2*2))
    tmp="$HERE/.shots/rec-cenario.cs"; mkdir -p "$(dirname "$tmp")"   # fora de tools/snippet/work (o host compila a pasta inteira)
    python3 "$HERE/tools/update/smoke.py" --subst "$src" "$tmp" "${subs[@]}" || die "não troquei as constantes"
    out="$GREEN/BepInEx/rec/$nome"; mkdir -p "$GREEN/BepInEx/rec"
    # Compila antes de gravar: o clipe só tem o que o cenário faz.
    cp "$tmp" "$HERE/tools/snippet/work/Snippet.cs"; refs >&2; builder
    docker exec -w /src/tools/snippet "$BUILDER" dotnet build -c Release -nologo -v q -clp:NoSummary >&2 || die "cenário não compilou"
    dll=$(stage "$HERE/tools/snippet/bin/Release/Snippet.dll" snippet)
    api "/rec/start?x=$rx&y=$ry&w=$rw&h=$rh&fps=$fps&scale=$escala&max=$((fps * 30))" >/dev/null || die "gravador não iniciou (DevBridge 0.2.0? rode gk2 bridge)"
    sleep "$antes"
    if ! res=$(GK2_TIMEOUT=180 api "/run?path=$(urlenc "$dll")&timeout=120"); then
      api "/rec/stop?out=$(urlenc "$(winpath "$out")")" >/dev/null; rm -f "$out.rgb"; echo "$res" | tail -5; die "cenário falhou; gravação descartada"
    fi
    echo "$res" | grep -q '"ok": *true' || { api "/rec/stop?out=$(urlenc "$(winpath "$out")")" >/dev/null; rm -f "$out.rgb"; echo "$res" | tail -c 600; die "cenário falhou; gravação descartada"; }
    echo "$res" | python3 -c 'import json,sys; print("cenário:", json.load(sys.stdin).get("result"))' 2>/dev/null || true
    # Demo que desistiu no meio (item fora da tela, funcionalidade desligada) termina sem "demo ... ok": o clipe não presta.
    echo "$res" | python3 -c 'import json,re,sys; sys.exit(0 if re.match(r"demo .* ok", str(json.load(sys.stdin).get("result"))) else 1)' || {
      api "/rec/stop?out=$(urlenc "$(winpath "$out")")" >/dev/null; rm -f "$out.rgb"; die "demo não terminou com \"demo ... ok\"; gravação descartada"; }
    sleep "$depois"
    api "/rec/stop?out=$(urlenc "$(winpath "$out")")" | pretty | grep -E '"frames"|"w"|"h"' | tr -d ' \n'; echo
    read -r W H F < <(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d["w"], d["h"], d["fps"])' "$out.json")
    mkdir -p "$HERE/GK2HudPlus/previews" "$HERE/docs/media"
    raw=(-loglevel error -y -f rawvideo -pix_fmt rgb24 -s "${W}x${H}" -r "$F" -i "$out.rgb")
    if [ "$tomada" = 1 ]; then   # tomada de divulgação: só o MP4, de volta ao tamanho de tela, sem tocar nos previews
      mkdir -p "$HERE/docs/media/tomadas"
      ffmpeg "${raw[@]}" -vf "scale=iw*$escala:ih*$escala:flags=neighbor" -c:v libx264 -crf 14 -preset medium -pix_fmt yuv420p "$HERE/docs/media/tomadas/$nome.mp4" || die "ffmpeg mp4 falhou"
      rm -f "$out.rgb"; ls -la "$HERE/docs/media/tomadas/$nome.mp4" | awk '{print $5, $9}'; exit 0
    fi
    ffmpeg "${raw[@]}" -c:v libvpx -crf 10 -b:v 1M -auto-alt-ref 0 -pix_fmt yuv420p "$HERE/GK2HudPlus/previews/$nome.webm" || die "ffmpeg webm falhou"
    ffmpeg "${raw[@]}" -c:v libx264 -crf 16 -preset slow -pix_fmt yuv420p -movflags +faststart "$HERE/docs/media/$nome.mp4" || die "ffmpeg mp4 falhou"
    ffmpeg "${raw[@]}" -vf "scale=iw/2:ih/2:flags=neighbor,split[a][b];[a]palettegen=stats_mode=diff[p];[b][p]paletteuse=dither=none" "$HERE/docs/media/$nome.gif" || die "ffmpeg gif falhou"
    ffmpeg "${raw[@]}" -vf "select=eq(n\,$(( F * 3 / 2 )))" -frames:v 1 "$HERE/.shots/rec-$nome.png" 2>/dev/null || true
    rm -f "$out.rgb"
    ls -la "$HERE/GK2HudPlus/previews/$nome.webm" "$HERE/docs/media/$nome.mp4" "$HERE/docs/media/$nome.gif" | awk '{print $5, $9}'
    ;;
  run)
    # Compila um cenário (static class Snippet { static object Run() }) e executa dentro do jogo.
    src=${1:?arquivo .cs}; [ -f "$src" ] || die "não achei $src"
    mkdir -p "$HERE/tools/snippet/work"; cp "$src" "$HERE/tools/snippet/work/Snippet.cs"
    refs >&2; builder
    docker exec -w /src/tools/snippet "$BUILDER" dotnet build -c Release -nologo -v q -clp:NoSummary >&2 || die "cenário não compilou"
    dll="$HERE/tools/snippet/bin/Release/Snippet.dll"
    path=$(stage "$dll" snippet)
    api "/run?path=$(python3 -c 'import urllib.parse,sys;print(urllib.parse.quote(sys.argv[1]))' "$path")&timeout=${GK2_RUN_TIMEOUT:-60}" | print_logs
    ;;
  shot)
    # gk2 shot [nome] [--hideui] [--crop x,y,w,h] [--frames n]
    name=${1:-shot}; [[ "$name" == --* ]] && name=shot || shift || true
    q="frames=1"; crop=""
    while [ $# -gt 0 ]; do case "$1" in
      --hideui) q="$q&hideui=1" ;; --crop) crop=$2; shift ;; --frames) q="${q/frames=1/frames=$2}"; shift ;;
      *) die "opção desconhecida $1" ;; esac; shift; done
    mkdir -p "$SHOTS"; out="$SHOTS/$(date +%H%M%S)-$name.png"
    curl -sS --max-time 60 -o "$out" -w '%{http_code}' "$URL/shot?$q" | grep -q 200 || { cat "$out"; rm -f "$out"; die "print falhou"; }
    # Sem alfa: a captura vem com alfa 0 em áreas pretas, que viewers mostram como cinza/xadrez.
    python3 -c "
from PIL import Image; import sys
im=Image.open(sys.argv[1]).convert('RGB')
if sys.argv[2]:
    x,y,w,h=map(int,sys.argv[2].split(',')); im=im.crop((x,y,x+w,y+h))
im.save(sys.argv[1])" "$out" "$crop"
    echo "$out"
    ;;
  winshot)
    name=${1:-winshot}; mkdir -p "$SHOTS"; out="$SHOTS/$(date +%H%M%S)-$name.png"
    pid=$(ps1 green.ps1 status | sed -n 's/.*pid=\([0-9]*\).*/\1/p'); [ -n "$pid" ] || die "green parado"
    ps1 winshot.ps1 -ProcessId "$pid" -Out "$(winpath "$out")" >/dev/null; echo "$out"
    ;;
  log) api "/log?n=${1:-80}&grep=$(urlenc "${2:-}")" | print_logs ;;
  state) api /state | pretty ;;
  ping) api /ping | pretty ;;
  windows) api /windows | pretty ;;
  ui) api "/ui?filter=$(urlenc "${1:-}")&depth=${2:-8}&inactive=${3:-0}" ;;
  wait) wait_bridge "${1:-120}"; api /ping | pretty ;;
  gatilhos)
    # Índice de gatilhos do jogo (quem libera ícone/tutorial/resposta/recurso, em que conversa está cada fala).
    if [ "${1:-}" = "onde" ]; then python3 "$HERE/tools/check/gatilhos.py" onde "${2:?termo}" "$HERE/decomp/gatilhos.json"; exit 0; fi
    out=$(GK2_RUN_TIMEOUT=300 "$0" run "$HERE/tools/check/exportar.cs")
    echo "$out" | grep -q '"ok": true' || { echo "$out" | tail -5; die "export falhou (green rodando, save carregado, GK2 Insight no green?)"; }
    echo "$out" | grep '"result"'
    python3 "$HERE/tools/check/gatilhos.py" build "$GREEN/BepInEx/GK2Insight-dump" "$HERE/decomp" "$HERE/decomp/gatilhos.json"
    ;;
  check)
    # Barreira antes de promover: ids na tela, chaves do calendário contra o índice e auditoria do save carregado.
    proj=${1:?projeto}; [ "$proj" = GK2Hud ] && proj=GK2HudPlus
    [ "$proj" = GK2HudPlus ] || die "check só existe para GK2HudPlus (o GK2Hud vem nele) por enquanto"
    idx="$HERE/decomp/gatilhos.json"
    if [ ! -f "$idx" ] || [ "$HERE/refs/Managed/Assembly-CSharp.dll" -nt "$idx" ]; then "$0" gatilhos; fi
    out=$(GK2_RUN_TIMEOUT=300 "$0" run "$HERE/tools/check/gk2hud-estado.cs")
    echo "$out" | grep -q '"ok": true' || { echo "$out" | tail -5; die "varredura no green falhou"; }
    python3 "$HERE/tools/check/check.py" "$HERE" "$GREEN/BepInEx/gk2check/gk2hud.json" "$idx"
    python3 "$HERE/tools/check/teste.py" "$HERE" "$GREEN/BepInEx/gk2check/gk2hud.json" "$idx" >/dev/null || die "a barreira deixou passar um bug conhecido (rode tools/check/teste.py)"
    python3 "$HERE/tools/rec/rec.py" "$0" "$HERE" status --estrito | sed 's/^/clipes: /' || die "clipe do menu desatualizado ou faltando: gk2 rec desatualizados"
    ;;
  promote)
    # Entrega um mod aprovado. Blue: pacote Mods/Code (vale ao reabrir) + BepInEx/hot (o GK2 HotLoader aplica com o
    # jogo aberto e avisa na tela). --green: só a pasta hot do green, para ensaiar a entrega antes do blue.
    proj=${1:?projeto}; target=${2:-blue}
    case "$proj" in GK2Hud|GK2HudPlus) if [ "$target" != "--green" ]; then "$0" check GK2HudPlus || die "gk2 check GK2HudPlus falhou: nada promovido"; fi ;; esac
    dll=$(build "$proj")
    if [ "$target" = "--green" ]; then game="$GREEN"; else game="$BLUE"
      pack="$BLUE_DATA/Mods/Code/$proj"; mkdir -p "$pack/BepInEx/plugins/$proj"
      [ -f "$HERE/$proj/modinfo.json" ] && cp "$HERE/$proj/modinfo.json" "$pack/modinfo.json"
      cp "$dll" "$pack/BepInEx/plugins/$proj/$proj.dll"; echo "pacote: $pack (vale ao reabrir)"
      if [ -d "$HERE/$proj/previews" ]; then   # clipes do menu: no pacote e na cópia que o jogo já fez (vale para o hot-reload)
        for d in "$pack/BepInEx/plugins/$proj/previews" "$BLUE/BepInEx/plugins/$proj/previews"; do
          mkdir -p "$d"; rm -f "$d"/*.webm; cp "$HERE/$proj/previews/"*.webm "$d/"
        done
        echo "previews: $(ls "$HERE/$proj/previews/"*.webm | wc -l) clipes"
      fi
    fi
    case "$proj" in GK2HotLoader|GK2DevBridge) echo "$proj não se recarrega a quente: vale ao reabrir" ;;
      *) [ "$target" = "--sem-hot" ] && { echo "sem hot-reload (mod de gameplay): vale ao reabrir"; sha256sum "$dll"; exit 0; } ;;&
      *) mkdir -p "$game/BepInEx/hot"; cp "$dll" "$game/BepInEx/hot/$proj.dll.tmp"; mv -f "$game/BepInEx/hot/$proj.dll.tmp" "$game/BepInEx/hot/$proj.dll"
         echo "hot: $game/BepInEx/hot/$proj.dll (aplicado em ~2 s se o HotLoader estiver rodando)" ;;
    esac
    sha256sum "$dll"
    ;;
  update)
    # Roteiro completo depois de um update do jogo, com relatório em .update/. `gk2 update conferir` marca a versão
    # como conferida no blue (o GK2 HotLoader para de avisar) depois de olhar o relatório e os prints.
    U="$HERE/.update"; mkdir -p "$U"
    if [ "${1:-}" = conferir ]; then
      [ -f "$U/ultima" ] || die "rode gk2 update antes"
      . "$U/ultima"
      [ "$VEREDITO" = ok ] || die "o último gk2 update não passou ($VEREDITO): veja $RELATORIO"
      cmp -s <(sha256sum < "$BLUE/GraveyardKeeper2_Data/Managed/Assembly-CSharp.dll") <(echo "$HASH") || die "o jogo mudou depois do último gk2 update: rode de novo"
      cfg="$BLUE/BepInEx/config/arthur.gk2.hotloader.cfg"
      python3 - "$cfg" "$VERSAO" <<'EOF'
import os, re, sys
path, version = sys.argv[1:3]
text = open(path, encoding="utf-8-sig").read() if os.path.exists(path) else ""
line = f"VerifiedVersion = {version}"
if re.search(r"(?m)^VerifiedVersion\s*=.*$", text):
    text = re.sub(r"(?m)^VerifiedVersion\s*=.*$", line, text)
elif "[Game]" in text:
    text = text.replace("[Game]", "[Game]\n\n" + line, 1)
else:
    text = text.rstrip() + ("\n\n" if text.strip() else "") + "[Game]\n\n" + line + "\n"
open(path, "w", encoding="utf-8").write(text)
print(f"versão {version} marcada como conferida em {path}")
EOF
      exit 0
    fi
    hash=$(sha256sum < "$BLUE/GraveyardKeeper2_Data/Managed/Assembly-CSharp.dll")
    if [ -f "$U/ultima" ] && grep -qF "HASH='$hash'" "$U/ultima" && [ "${1:-}" != --forcar ]; then
      echo "o jogo não mudou desde o último gk2 update (--forcar roda de novo)"; exit 0
    fi
    ts=$(date +%Y%m%d-%H%M); R="$U/$ts.md"; falhas=()
    section() { printf '\n## %s\n\n' "$1" >> "$R"; echo "== $1"; }
    echo "# gk2 update $ts" > "$R"

    section "Sincronização"
    "$0" green stop >/dev/null 2>&1 || true
    "$0" green-sync | tee -a "$R"

    section "Código do jogo × mods"
    refs >/dev/null
    if [ -d "$HERE/decomp" ]; then rm -rf "$HERE/decomp.anterior"; mv "$HERE/decomp" "$HERE/decomp.anterior"; fi
    "$0" decomp >/dev/null
    if [ -d "$HERE/decomp.anterior" ]; then
      python3 "$HERE/tools/update/relatorio.py" "$HERE/decomp.anterior" "$HERE/decomp" "$HERE" > "$U/codigo.md"
      cat "$U/codigo.md" >> "$R"; alertas=$(sed -n 's/^ALERTAS //p' "$U/codigo.md"); echo "alertas: $alertas"
      [ "$alertas" = 0 ] || falhas+=("código: $alertas alerta(s)")
    else echo "- sem decomp anterior para comparar" >> "$R"; fi

    section "Build contra o jogo novo"
    projetos="GK2DevBridge GK2HotLoader GK2Insight GK2Hud GK2Map GK2Saves GK2ZombieRefund GK2HudPlus"
    for p in $projetos; do
      if dll=$(build "$p" 2>"$U/build-$p.log"); then
        avisos=$(grep -c -i "warning" "$U/build-$p.log" || true)
        # Os avulsos só compilam: no green quem roda é o GK2 HUD+, que já os traz.
        case "$p" in GK2Hud|GK2Map|GK2Saves|GK2ZombieRefund) ;; *) install_green "$dll" "$p" >/dev/null ;; esac
        echo "- $p ok ($avisos aviso(s))" | tee -a "$R"
      else echo "- $p FALHOU (ver .update/build-$p.log)" | tee -a "$R"; falhas+=("build de $p"); fi
    done

    section "Índice e barreira (builds novos no green)"
    ps1 green.ps1 start >/dev/null; wait_bridge
    "$0" run "$HERE/docs/cenarios/continuar.cs" | grep -q '"em jogo"' || die "o save de teste não carregou no green (ver gk2 log)"
    versao=$("$0" run "$HERE/tools/update/versao.cs" | sed -n 's/.*"result": "\(.*\)".*/\1/p')
    echo "- versão do jogo: $versao" | tee -a "$R"
    if "$0" gatilhos > "$U/gatilhos.log" 2>&1; then tail -1 "$U/gatilhos.log" | sed 's/^/- /' >> "$R"; else echo "- gatilhos FALHOU" | tee -a "$R"; falhas+=("gatilhos"); fi
    if "$0" check GK2HudPlus > "$U/check.log" 2>&1; then echo "- gk2 check GK2HudPlus ok" | tee -a "$R"
    else echo "- gk2 check GK2HudPlus FALHOU (ver .update/check.log)" | tee -a "$R"; falhas+=("check GK2HudPlus"); fi

    section "Mods do blue (Mods/Code) no green"
    "$0" green stop >/dev/null 2>&1
    for d in GK2Hud GK2Map GK2Saves GK2ZombieRefund GK2HudPlus; do rm -rf "$GREEN/BepInEx/plugins/$d"; done   # só o que vem do blue
    for pack in "$BLUE_DATA"/Mods/Code/*/; do
      for dll in "$pack"BepInEx/plugins/*/*.dll; do
        [ -f "$dll" ] || continue; p=$(basename "$(dirname "$dll")")
        mkdir -p "$GREEN/BepInEx/plugins/$p"; cp "$dll" "$GREEN/BepInEx/plugins/$p/"
        echo "- $p $(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$pack/modinfo.json" 2>/dev/null)" | tee -a "$R"
      done
    done
    "$0" save reset >/dev/null
    ps1 green.ps1 start >/dev/null; wait_bridge
    "$0" run "$HERE/docs/cenarios/continuar.cs" | grep -q '"em jogo"' || die "o save de teste não carregou com os mods do blue (ver gk2 log)"
    printf '\nBateria (%s):\n\n' "tools/update/smoke.txt" >> "$R"
    if python3 "$HERE/tools/update/smoke.py" "$0" "$HERE/tools/update/smoke.txt" "$U/cenarios" "upd-$ts" | tee -a "$R"; then :; else falhas+=("bateria"); fi
    printf '\nLog do jogo:\n\n' >> "$R"
    if python3 "$HERE/tools/update/excecoes.py" "$GREEN_DATA/Player.log" "$HERE/tools/update/excecoes-do-jogo.txt" | tee -a "$R"; then :; else falhas+=("erros no log"); fi

    section "Green de volta aos builds do repo"
    "$0" green stop >/dev/null 2>&1
    for d in GK2Hud GK2Map GK2Saves GK2ZombieRefund; do rm -rf "$GREEN/BepInEx/plugins/$d"; done
    for p in $projetos; do
      case "$p" in GK2Hud|GK2Map|GK2Saves|GK2ZombieRefund) continue ;; esac
      [ -f "$HERE/$p/bin/Release/$p.dll" ] && install_green "$HERE/$p/bin/Release/$p.dll" "$p" >/dev/null
    done
    "$0" save reset >/dev/null; echo "- builds do repo reinstalados, save de teste restaurado, green parado" | tee -a "$R"

    veredito=ok; [ ${#falhas[@]} -eq 0 ] || veredito="falhou: ${falhas[*]}"
    section "Veredito"
    echo "- $veredito" | tee -a "$R"
    printf "VERSAO='%s'\nHASH='%s'\nVEREDITO='%s'\nRELATORIO='%s'\n" "$versao" "$hash" "$veredito" "$R" > "$U/ultima"
    echo "relatório: $R"
    if [ "$veredito" = ok ]; then echo "olhe os prints (.shots/*upd-$ts*) e rode: gk2 update conferir"; else exit 1; fi
    ;;
  decomp)
    refs; rm -rf "$HERE/decomp"; mkdir -p "$HERE/decomp"
    docker run --rm -e DOTNET_ROLL_FORWARD=Major -v "$HERE":/w -w /w "$SDK_IMAGE" bash -c 'dotnet tool install -g ilspycmd --version 8.2.0.7535 >/dev/null 2>&1; export PATH=$PATH:/root/.dotnet/tools; for a in Assembly-CSharp LazyBearTechnology; do ilspycmd -p -o decomp/$a -r refs/Managed refs/Managed/$a.dll >/dev/null 2>&1; done'
    find "$HERE/decomp" -name '*.cs' | wc -l
    ;;
  help|*)
    sed -n 's/^  \([a-z-]*\)).*/\1/p' "$0" | tr '\n' ' '; echo
    cat <<'EOF'
green start|stop|restart|status|show|hide|sync-settings   instância green (D:\GK2-green, janela fora da tela)
green-sync                 re-sincroniza o green com o jogo após update (green parado)
update [--forcar|conferir]  depois de update do jogo: sync, relatório do código × mods, build, gatilhos, check e
                           bateria com os DLLs do blue → .update/<data>.md; `conferir` marca a versão no blue
save snapshot|reset        snapshot = copia o save do blue; reset = green volta ao snapshot
build <Proj>               compila (container gk2-builder persistente)
bridge                     compila e instala a DevBridge no green (reinicia o green)
deploy <Proj>              compila, instala no green e faz hot-reload
unload <guid>              descarrega um plugin recarregável
run <arquivo.cs>           executa um cenário C# dentro do jogo (static class Snippet { static object Run() })
shot [nome] [--hideui] [--crop x,y,w,h] [--frames n]   print pelo Unity → .shots/
rec status|todos|desatualizados|<Id>   clipes do menu do HUD+ (tools/rec/clips.txt); status diz quais ficaram velhos
rec-clip <demo.cs> <x,y,w,h> <Id> [K=V]   grava um clipe avulso (WebM em previews/, GIF/MP4 em docs/media/)
showcase [webp|trailer|gameplay|capa] mídias de divulgação: docs/showcase/*.webp (README) e docs/media/reddit/trailer.mp4
package <Proj>             dist/<Proj>-<versão>.zip no layout do jogo (Mods/Code), para a página de releases
winshot [nome]             print pela janela (fallback, sem ponte)
log [n] [grep] | state | ping | windows | ui [filtro] [prof] [inativos 0|1] | wait [s]
promote <Proj> [--green|--sem-hot]   entrega o mod aprovado (blue: Mods/Code + hot-reload pelo HotLoader; --green: ensaio)
decomp                     regenera decomp/ (após update do jogo; depois rode `gk2 gatilhos`)
gatilhos [onde <termo>]    índice decomp/gatilhos.json (balanço + grafos de diálogo + código); `onde` diz quem libera/usa o termo
check GK2HudPlus           barreira do promote: ids na tela, calendário × índice, auditoria do save carregado (sem spoiler)
EOF
    ;;
esac
